# Copie para .env e ajuste. Nunca versione o .env.

# Aplicação
APP_NAME="DDD Structure"
ENVIRONMENT=development          # development | testing | staging | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=console               # console | json
CORS_ORIGINS=[]                  # ex.: ["https://app.exemplo.com"]

# Banco de dados (SQLite por padrão; PostgreSQL via docker compose)
DATABASE_URL=sqlite+aiosqlite:///./app.db
# DATABASE_URL=postgresql+asyncpg://ddd:ddd@localhost:5432/ddd
DATABASE_ECHO=false

# Regras de negócio
WORK_IN_PROGRESS_LIMIT=3

# docker compose
POSTGRES_USER=ddd
POSTGRES_PASSWORD=ddd
POSTGRES_DB=ddd
POSTGRES_PORT=5432
API_PORT=8000

# Testes contra PostgreSQL (opcional)
# TEST_DATABASE_URL=postgresql+asyncpg://ddd:ddd@localhost:5432/ddd
